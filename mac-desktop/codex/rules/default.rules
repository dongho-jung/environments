prefix_rule(pattern=["adb", "shell"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["godot", "--headless"], decision="allow")
prefix_rule(pattern=["python3", "-m", "http.server"], decision="allow")
prefix_rule(pattern=["curl", "-I"], decision="allow")
prefix_rule(pattern=["./gradlew", "assembleDebug"], decision="allow")
