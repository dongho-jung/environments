{
    // Small status bar along the bottom edge of the screen.
    "layer": "top",
    "position": "bottom",
    "height": 26,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/recording", "custom/vpn", "cpu", "temperature", "memory", "disk", "network", "bluetooth", "pulseaudio", "tray", "custom/potential-lock"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "enable-bar-scroll": true
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },

    // Only visible while our region/window recorder owns a live wf-recorder process.
    // Clicking the red pill stops the recording and finalizes the MP4.
    "custom/recording": {
        "interval": 1,
        "signal": 8,
        "exec": "$HOME/.config/hypr/record-region.sh status",
        "return-type": "json",
        "format": "{text}",
        "hide-empty-text": true,
        "on-click": "$HOME/.config/hypr/record-region.sh stop"
    },

    // OpenVPN "user-locked" tunnel status. vpn-status.sh prints JSON; the pill is
    // only shown (styled bright green) while connected. Left/right click toggles.
    "custom/vpn": {
        "interval": 2,
        "exec": "$HOME/.config/waybar/vpn-status.sh",
        "return-type": "json",
        "format": "{}",
        "on-click": "sudo -n /usr/local/bin/vpn-up",
        "on-click-right": "sudo -n /usr/local/bin/vpn-down"
    },

    "clock": {
        "interval": 1,
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%"
    },

    "temperature": {
        "interval": 2,
        // Stable device path (hwmonN numbering is not stable across reboots).
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "TEMP {temperatureC}°C",
        "format-critical": "TEMP {temperatureC}°C!"
    },

    "memory": {
        "interval": 2,
        "format": "RAM {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "disk": {
        "interval": 30,
        "path": "/",
        "format": "DISK {percentage_used}%",
        "tooltip-format": "{used} / {total} used ({free} free) on {path}"
    },

    "network": {
        "interval": 2,
        "format-ethernet": "↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "format-wifi": "{essid} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "format-disconnected": "no net",
        "tooltip-format": "{ifname}: {ipaddr}\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}"
    },

    // Persistent adapter/connection status. Click to pair, trust, connect, or
    // remove devices in Blueman; audio routing remains PipeWire's job.
    "bluetooth": {
        "format": "BT {status}",
        "format-disabled": "BT disabled",
        "format-off": "BT off",
        "format-on": "BT on",
        "format-connected": "BT {device_alias}",
        "format-connected-battery": "BT {device_alias} {device_battery_percentage}%",
        "format-no-controller": "BT unavailable",
        "max-length": 32,
        "tooltip-format": "{controller_alias}: {status}",
        "tooltip-format-connected": "{controller_alias}: {status}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} · battery {device_battery_percentage}%",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "VOL {volume}% · {desc}",
        "format-bluetooth": "BT VOL {volume}% · {desc}",
        "format-muted": "VOL muted · {desc}",
        "max-length": 36,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol --tab=3"
    },

    // Deliberately reveals only whether the input shield is active. The host's
    // policy and verifier remain in private, machine-local state.
    "custom/potential-lock": {
        "interval": 2,
        "signal": 9,
        "exec": "$HOME/.config/hypr/potential-lock status",
        "return-type": "json",
        "format": "{}",
        "hide-empty-text": true
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
