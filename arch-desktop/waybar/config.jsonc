{
    // Small status bar along the bottom edge of the screen.
    "layer": "top",
    "position": "bottom",
    "height": 26,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "temperature", "memory", "disk", "network", "pulseaudio", "tray"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },

    "clock": {
        "interval": 1,
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%"
    },

    "temperature": {
        "interval": 2,
        // Stable device path (hwmonN numbering is not stable across reboots).
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "TEMP {temperatureC}°C",
        "format-critical": "TEMP {temperatureC}°C!"
    },

    "memory": {
        "interval": 2,
        "format": "RAM {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "disk": {
        "interval": 30,
        "path": "/",
        "format": "DISK {percentage_used}%",
        "tooltip-format": "{used} / {total} used ({free} free) on {path}"
    },

    "network": {
        "interval": 2,
        "format-ethernet": "↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "format-wifi": "{essid} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "format-disconnected": "no net",
        "tooltip-format": "{ifname}: {ipaddr}\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}"
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
