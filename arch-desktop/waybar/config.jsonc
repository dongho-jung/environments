{
    // Small status bar along the bottom edge of the screen.
    "layer": "top",
    "position": "bottom",
    "height": 26,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/recording", "custom/vpn", "cpu", "temperature", "memory", "disk", "network", "pulseaudio", "tray"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },

    // Only visible while our region/window recorder owns a live wf-recorder process.
    // Clicking the red pill stops the recording and finalizes the MP4.
    "custom/recording": {
        "interval": 1,
        "signal": 8,
        "exec": "/home/dongho/.config/hypr/record-region.sh status",
        "return-type": "json",
        "format": "{text}",
        "hide-empty-text": true,
        "on-click": "/home/dongho/.config/hypr/record-region.sh stop"
    },

    // OpenVPN "user-locked" tunnel status. vpn-status.sh prints JSON; the pill is
    // only shown (styled bright green) while connected. Left/right click toggles.
    "custom/vpn": {
        "interval": 2,
        "exec": "/home/dongho/.config/waybar/vpn-status.sh",
        "return-type": "json",
        "format": "{}",
        "on-click": "sudo -n /usr/local/bin/vpn-up",
        "on-click-right": "sudo -n /usr/local/bin/vpn-down"
    },

    "clock": {
        "interval": 1,
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%"
    },

    "temperature": {
        "interval": 2,
        // Stable device path (hwmonN numbering is not stable across reboots).
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "TEMP {temperatureC}°C",
        "format-critical": "TEMP {temperatureC}°C!"
    },

    "memory": {
        "interval": 2,
        "format": "RAM {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "disk": {
        "interval": 30,
        "path": "/",
        "format": "DISK {percentage_used}%",
        "tooltip-format": "{used} / {total} used ({free} free) on {path}"
    },

    "network": {
        "interval": 2,
        "format-ethernet": "↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "format-wifi": "{essid} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "format-disconnected": "no net",
        "tooltip-format": "{ifname}: {ipaddr}\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}"
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
