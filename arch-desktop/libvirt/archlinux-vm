#!/usr/bin/env bash
set -euo pipefail

export LC_ALL=C

readonly connection="qemu:///system"
readonly vm_name="archlinux"
readonly network_name="default"
readonly storage_pool="default"
readonly disk_volume="${vm_name}.qcow2"
readonly memory_mib="8192"
readonly vcpus="4"
readonly disk_gib="64"

usage() {
  cat <<'EOF'
Usage: archlinux-vm [--print-xml] [ARCHLINUX_ISO]

Create or start the managed Arch Linux VM and open its graphical console.
The newest archlinux-*.iso in ~/Downloads is used when ARCHLINUX_ISO is omitted.

Options:
  --print-xml  Print the existing or prospective libvirt domain XML and exit.
  -h, --help   Show this help.

Environment:
  ARCHLINUX_ISO           Override the installer ISO path.
  ARCHLINUX_VM_NO_CONSOLE Set to 1 to skip opening virt-manager.
EOF
}

die() {
  printf 'archlinux-vm: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1"
}

resolve_archlinux_iso() {
  local requested="${1:-${ARCHLINUX_ISO:-}}"

  if [[ -n "$requested" ]]; then
    [[ -f "$requested" ]] || die "Arch Linux ISO not found: $requested"
    [[ -r "$requested" ]] || die "Arch Linux ISO is not readable: $requested"
    readlink -f -- "$requested"
    return
  fi

  local downloads_dir="${XDG_DOWNLOAD_DIR:-${HOME:?}/Downloads}"
  local -a candidates=()
  local candidate
  local selected=""

  shopt -s nullglob nocaseglob
  candidates=("$downloads_dir"/archlinux-*.iso)
  shopt -u nullglob nocaseglob

  ((${#candidates[@]} > 0)) ||
    die "no archlinux-*.iso found in $downloads_dir"

  selected="${candidates[0]}"
  for candidate in "${candidates[@]:1}"; do
    [[ "$candidate" -nt "$selected" ]] && selected="$candidate"
  done

  readlink -f -- "$selected"
}

cpu_topology_matches() {
  local xml="$1"
  local topology

  topology="$(grep -m1 -E '<topology([[:space:]>])' <<<"$xml" || true)"
  [[ -n "$topology" ]] &&
    grep -Eq "sockets=['\"]1['\"]" <<<"$topology" &&
    grep -Eq "cores=['\"]${vcpus}['\"]" <<<"$topology" &&
    grep -Eq "threads=['\"]1['\"]" <<<"$topology"
}

network_is_active() {
  local info

  info="$(virsh --connect "$connection" net-info "$network_name")" || return 1
  grep -Eq '^Active:[[:space:]]+yes$' <<<"$info"
}

pool_is_active() {
  local info

  info="$(virsh --connect "$connection" pool-info "$storage_pool")" || return 1
  grep -Eq '^State:[[:space:]]+running$' <<<"$info"
}

open_console() {
  if [[ "${ARCHLINUX_VM_NO_CONSOLE:-0}" == "1" ]]; then
    return
  fi

  printf 'Opening the %s console...\n' "$vm_name"
  virt-manager \
    --connect "$connection" \
    --show-domain-console "$vm_name"
}

mode="launch"
case "${1:-}" in
  --print-xml)
    mode="print-xml"
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  -*)
    usage >&2
    die "unknown option: $1"
    ;;
esac

(($# <= 1)) || {
  usage >&2
  die "expected at most one Arch Linux ISO path"
}

require_command grep
require_command readlink
require_command virsh
require_command virt-install
require_command virt-manager
require_command virt-xml

if virsh --connect "$connection" dominfo "$vm_name" >/dev/null 2>&1; then
  domain_xml="$(virsh --connect "$connection" dumpxml --inactive "$vm_name")"

  if [[ "$mode" == "print-xml" ]]; then
    printf '%s\n' "$domain_xml"
    exit 0
  fi

  state="$(virsh --connect "$connection" domstate "$vm_name")"
  if ! cpu_topology_matches "$domain_xml"; then
    case "$state" in
      "shut off" | crashed)
        printf 'Updating %s to one socket with %s cores...\n' \
          "$vm_name" "$vcpus"
        virt-xml "$vm_name" \
          --connect "$connection" \
          --edit \
          --vcpus "${vcpus},sockets=1,cores=${vcpus},threads=1" \
          >/dev/null
        domain_xml="$(virsh --connect "$connection" dumpxml --inactive "$vm_name")"
        cpu_topology_matches "$domain_xml" ||
          die "failed to apply the expected CPU topology to $vm_name"
        ;;
      *)
        die "$vm_name must be shut down to correct its CPU topology"
        ;;
    esac
  fi

  case "$state" in
    running)
      ;;
    paused)
      printf 'Resuming %s...\n' "$vm_name"
      virsh --connect "$connection" resume "$vm_name" >/dev/null
      ;;
    "shut off" | crashed)
      printf 'Starting %s...\n' "$vm_name"
      virsh --connect "$connection" start "$vm_name" >/dev/null
      ;;
    *)
      die "cannot automatically start $vm_name from state: $state"
      ;;
  esac

  open_console
  exit 0
fi

archlinux_iso="$(resolve_archlinux_iso "${1:-}")"

virsh --connect "$connection" net-info "$network_name" >/dev/null 2>&1 ||
  die "libvirt network is not defined: $network_name"
if [[ "$mode" == "launch" ]] && ! network_is_active; then
  printf 'Starting libvirt network %s...\n' "$network_name"
  if ! virsh --connect "$connection" net-start "$network_name" \
    >/dev/null 2>&1; then
    network_is_active ||
      die "failed to start libvirt network: $network_name"
  fi
fi

virsh --connect "$connection" pool-info "$storage_pool" >/dev/null 2>&1 ||
  die "libvirt storage pool is not defined: $storage_pool"
if [[ "$mode" == "launch" ]] && ! pool_is_active; then
  printf 'Starting libvirt storage pool %s...\n' "$storage_pool"
  if ! virsh --connect "$connection" pool-start "$storage_pool" \
    >/dev/null 2>&1; then
    pool_is_active ||
      die "failed to start libvirt storage pool: $storage_pool"
  fi
fi

disk_spec="pool=${storage_pool},size=${disk_gib},format=qcow2,bus=virtio"
if virsh --connect "$connection" vol-info \
  --pool "$storage_pool" "$disk_volume" >/dev/null 2>&1; then
  disk_spec="vol=${storage_pool}/${disk_volume},bus=virtio"
fi

install_args=(
  virt-install
  --connect "$connection"
  --name "$vm_name"
  --memory "$memory_mib"
  --vcpus "${vcpus},sockets=1,cores=${vcpus},threads=1"
  --cpu host-passthrough
  --machine q35
  --boot uefi
  --osinfo archlinux
  --disk "$disk_spec"
  --cdrom "$archlinux_iso"
  --network "network=${network_name},model=virtio"
  --graphics spice
  --video virtio
  --sound ich9
  --noautoconsole
)

prospective_xml="$("${install_args[@]}" --dry-run --print-xml=1)"
cpu_topology_matches "$prospective_xml" ||
  die "generated domain does not have the expected CPU topology"

if [[ "$mode" == "print-xml" ]]; then
  printf '%s\n' "$prospective_xml"
  exit 0
fi

printf 'Creating %s from %s...\n' "$vm_name" "$archlinux_iso"
"${install_args[@]}"

domain_xml="$(virsh --connect "$connection" dumpxml --inactive "$vm_name")"
cpu_topology_matches "$domain_xml" ||
  die "created domain does not have the expected CPU topology"

open_console
